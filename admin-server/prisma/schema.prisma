// LabLock CM - Prisma Schema (Configurado para PostgreSQL / Neon.tech)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              Int       @id @default(autoincrement())
  nombre          String    @unique // Nombre del alumno/maestro o 'adminCM' para soporte
  rol             String    @default("alumno") // 'alumno' | 'maestro' | 'admin'
  grupo_id        String?   // Identificador del grupo escolar (ej. '1A', '2B', 'Sistemas')
  activo          Boolean   @default(true)
  pin_o_password  String?   // Hash bcrypt para adminCM y docentes
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions        Session[]

  @@map("users")
}

model Workstation {
  id           Int       @id @default(autoincrement())
  machine_name String    @unique // Nombre de red de Windows (os.hostname())
  ip_address   String    @default("127.0.0.1")
  estado       String    @default("disponible") // 'disponible' | 'en_uso' | 'bloqueado'
  ultimo_ping  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]

  @@map("workstations")
}

model Session {
  id             Int          @id @default(autoincrement())
  user_id        Int
  workstation_id Int
  fecha          DateTime     @default(now())
  hora_inicio    DateTime     @default(now())
  hora_fin       DateTime?
  estado         String       @default("activa") // 'activa' | 'cerrada' | 'forzada_cierre'
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workstation    Workstation  @relation(fields: [workstation_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([workstation_id])
  @@index([estado])
  @@map("sessions")
}
